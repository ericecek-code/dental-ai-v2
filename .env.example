# Skopíruj na .env a vyplň. NIKDY necommituj .env.
# Konfigurácia číta .env z KOREŇA projektu (absolútna cesta — nezávisle od CWD).

# --- Prihlásenie ---
# Viacerí používatelia: USERS="lekar:heslo1,asistentka:heslo2" (vyhradí APP_PASSWORD demo režim)
USERS=
# Demo režim (jedno spoločné heslo), ak je USERS prázdne:
APP_PASSWORD=zmen-ma
# AI druhy nazor (VLM) — konkretny model (nie "latest" alias) + zalozne modely (ciarkou)
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite
# Podpis session cookies — prázdne = auto-generované do backend/data/.secret (pri deploye nastav a rotuj!)
SECRET=

# --- Detekcia ---
CONF_THRESHOLD=0.25
MAX_UPLOAD_MB=15
WEIGHTS_PATH=weights/best.pt
TTA_ENABLED=true
TTA_AUGMENTATIONS=5
MC_DROPOUT_ENABLED=true
MC_DROPOUT_PASSES=5
MC_DROPOUT_RATE=0.1

# --- Webová vrstva ---
# Povolené originy pre CORS pri deploye: ALLOWED_ORIGINS="https://tvoj-space.hf.space"
ALLOWED_ORIGINS=
# Secure cookie pri HTTPS deploye:
COOKIE_SECURE=false

# --- Supabase (Deň 1-2; pokým nie je, backend beží na lokálnom SQLite) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Voliteľné: Kaggle CLI (alternatíva k ~/.kaggle/kaggle.json) ---
KAGGLE_USERNAME=
KAGGLE_KEY=
